---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactSection from "@/components/ContactSection.astro";
import OpeningHours from "@/components/OpeningHours.astro";
import { useTranslations, type Locale, locales } from "@/i18n/utils";
import { siteConfig } from "@/config/site";

export const prerender = true;

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);
---

<BaseLayout
  title={`${t("contact.title")} — ${siteConfig.name}`}
  description={`${t("contact.address")} · ${t("contact.whatsappLabel")}: ${siteConfig.contact.whatsappDisplay}`}
>
  <section class="container-narrow pt-28 pb-10 text-center reveal">
    <p class="eyebrow mb-6">{t("hero.eyebrow")}</p>
    <h1 class="display italic text-6xl md:text-8xl text-[var(--color-gold-soft)]">
      {t("contact.title")}
    </h1>
  </section>

  <div class="reveal">
    <ContactSection locale={locale} />
  </div>
  <div class="reveal">
    <OpeningHours locale={locale} />
  </div>
</BaseLayout>
