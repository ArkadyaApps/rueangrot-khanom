---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeroSection from "@/components/HeroSection.astro";
import OpeningHours from "@/components/OpeningHours.astro";
import ContactSection from "@/components/ContactSection.astro";
import InstagramFeed from "@/components/InstagramFeed.astro";
import ReservationStrip from "@/components/ReservationStrip.astro";
import { useTranslations, type Locale, locales } from "@/i18n/utils";
import { siteConfig } from "@/config/site";

export const prerender = true;

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);

const photos = siteConfig.images.menu;
const [featuredPhoto, ...gridPhotos] = photos;
---

<BaseLayout
  title={`${siteConfig.name} — ${t("hero.eyebrow")}`}
  description={t("hero.subtitle")}
>

  <HeroSection locale={locale} />

  <!-- About — editorial asymmetric split -->
  <section id="about" class="container-narrow py-24 md:py-36">
    <div class="grid md:grid-cols-12 gap-10 md:gap-16 items-start">
      <!-- Left: sticky pullquote -->
      <div class="md:col-span-5 md:sticky md:top-28 reveal">
        <p class="eyebrow mb-5">{t("about.title")}</p>
        <p class="display italic text-[clamp(2rem,4.5vw,3.2rem)] text-[var(--color-gold-soft)] leading-[1.08]">
          "{t("about.pullquote")}"
        </p>
        <div class="mt-7 flex items-center gap-3" aria-hidden="true">
          <span class="block h-px w-16 gold-rule opacity-70"></span>
          <svg width="11" height="11" viewBox="0 0 24 24" fill="var(--color-gold)" style="flex-shrink:0;opacity:0.75;">
            <path d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5Z"/>
          </svg>
        </div>
      </div>

      <!-- Right: body + featured image -->
      <div class="md:col-span-6 md:col-start-7 md:border-l md:border-[var(--color-line)] md:pl-10 space-y-8 reveal reveal-d2">
        <p class="text-lg md:text-xl text-[var(--color-fg-muted)] leading-loose font-light">
          {t("about.body")}
        </p>

        {featuredPhoto && (
          <div class="aspect-[4/3] overflow-hidden rounded-sm">
            <img
              src={featuredPhoto}
              alt={t("menu.title")}
              loading="lazy"
              class="w-full h-full object-cover hover:scale-[1.03] transition-transform duration-700 ease-out"
            />
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Menu photo mosaic -->
  {gridPhotos.length > 0 && (
    <section class="container-narrow pb-16 reveal">
      <header class="text-center mb-10">
        <p class="eyebrow mb-3">{t("menu.title")}</p>
        <p class="text-sm text-[var(--color-fg-muted)]">{t("menu.intro")}</p>
        <div class="gold-rule mt-5 max-w-[80px] mx-auto"></div>
      </header>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-2 md:gap-3">
        {gridPhotos.map((src, i) => (
          <div class={`overflow-hidden rounded-sm ${i === 0 ? "md:col-span-2 aspect-[16/9]" : "aspect-square"}`}>
            <img
              src={src}
              alt={`${t("menu.title")} ${i + 2}`}
              loading="lazy"
              class="w-full h-full object-cover hover:scale-[1.04] transition-transform duration-700 ease-out"
            />
          </div>
        ))}
      </div>
    </section>
  )}

  <div class="reveal">
    <ReservationStrip locale={locale} />
  </div>

  <div id="hours" class="reveal">
    <OpeningHours locale={locale} />
  </div>

  <div class="reveal">
    <InstagramFeed locale={locale} />
  </div>
  <div class="reveal">
    <ContactSection locale={locale} />
  </div>

</BaseLayout>
