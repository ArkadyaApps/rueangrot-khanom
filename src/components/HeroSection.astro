---
import { useTranslations, localizedPath, type Locale } from "@/i18n/utils";
import { siteConfig } from "@/config/site";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const fmt = new Intl.DateTimeFormat("en-US", { weekday: "long", timeZone: siteConfig.timezone });
const todayName = fmt.format(new Date()).toLowerCase() as keyof typeof siteConfig.hours;
const isClosedToday = siteConfig.hours[todayName] === null;
const todaySlot = siteConfig.hours[todayName];
---

<section class="relative overflow-hidden min-h-[88svh] flex items-center" aria-label={siteConfig.name}>

  <!-- Cinematic ambient loop — rendered per-theme via HyperFrames -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <video class="absolute inset-0 w-full h-full object-cover" autoplay muted loop playsinline poster="/images/og.png">
      <source src="/videos/hero.mp4" type="video/mp4" />
    </video>
  </div>

  <!-- Theme-aware ambient glow layers -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute inset-0" style="
      background:
        radial-gradient(ellipse 55% 45% at 18% 30%, oklch(from var(--color-accent) l c h / 0.28), transparent),
        radial-gradient(ellipse 45% 55% at 82% 25%, oklch(from var(--color-gold) l c h / 0.18), transparent),
        radial-gradient(ellipse 60% 40% at 55% 80%, oklch(from var(--color-accent-deep) l c h / 0.2), transparent);
    "></div>
    <!-- subtle breathing animation -->
    <div class="absolute inset-0 hero-breathe"></div>
  </div>

  <!-- Decorative line grid — editorial feel -->
  <div class="absolute inset-0 pointer-events-none opacity-[0.03]" aria-hidden="true" style="
    background-image: linear-gradient(var(--color-gold) 1px, transparent 1px),
                      linear-gradient(90deg, var(--color-gold) 1px, transparent 1px);
    background-size: 80px 80px;
  "></div>

  <!-- Large background letterform -->
  <div class="absolute inset-0 flex items-center justify-center pointer-events-none select-none overflow-hidden" aria-hidden="true">
    <span class="display italic leading-none text-[var(--color-accent)] opacity-[0.04]"
      style="font-size: clamp(20rem, 50vw, 56rem); letter-spacing: -0.08em;">
      {siteConfig.name[0]}
    </span>
  </div>

  <!-- Corner marks -->
  {["top-5 left-5", "top-5 right-5 -scale-x-100", "bottom-5 left-5 -scale-y-100", "bottom-5 right-5 -scale-100"].map((pos) => (
    <svg class={`absolute ${pos} w-7 h-7 opacity-30 text-[var(--color-gold-deep)]`} viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="0.8" aria-hidden="true">
      <path d="M2 2 L2 11 M2 2 L11 2"/>
    </svg>
  ))}

  <div class="container-narrow relative z-10 py-16 md:py-24 text-center w-full">

    <!-- Status pill -->
    <div class="flex justify-center mb-8 hero-in" style="--d:0ms">
      <span class={`inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full border text-[0.64rem] uppercase tracking-[0.3em] backdrop-blur-sm ${isClosedToday ? "border-[var(--color-line-strong)] text-[var(--color-fg-muted)] bg-[oklch(from_var(--color-bg)_l_c_h_/_0.5)]" : "border-[var(--color-gold-deep)] text-[var(--color-gold-soft)] bg-[oklch(from_var(--color-surface)_l_c_h_/_0.65)]"}`}>
        <span class={`h-1.5 w-1.5 rounded-full flex-shrink-0 ${isClosedToday ? "bg-[var(--color-fg-subtle)]" : "bg-[var(--color-gold)] status-pulse"}`} aria-hidden="true"></span>
        {isClosedToday ? t("hours.closedLabel") : t("hours.openNow")}
        {!isClosedToday && todaySlot && (
          <>
            <span class="opacity-40">·</span>
            <span class="opacity-70 normal-case tracking-[0.18em]">{todaySlot.open} – {todaySlot.close}</span>
          </>
        )}
      </span>
    </div>

    <!-- Eyebrow -->
    <p class="eyebrow mb-6 md:mb-8 hero-in" style="--d:100ms">{t("hero.eyebrow")}</p>

    <!-- Main title -->
    <h1 class="display italic text-[var(--color-gold-soft)] hero-in" style="--d:180ms; font-size: clamp(3.8rem, 11vw, 9.5rem); line-height: 0.88;">
      {t("hero.title")}
    </h1>

    <!-- Decorative gold rule -->
    <div class="my-10 md:my-12 flex items-center justify-center gap-4 hero-in" style="--d:300ms" aria-hidden="true">
      <span class="block h-px w-16 md:w-28 gold-rule"></span>
      <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" class="text-[var(--color-gold)] opacity-70" style="flex-shrink:0;">
        <path d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5Z"/>
      </svg>
      <span class="block h-px w-16 md:w-28 gold-rule"></span>
    </div>

    <!-- Subtitle -->
    <p class="mx-auto max-w-lg text-lg md:text-xl text-[var(--color-fg-muted)] leading-relaxed font-light hero-in" style="--d:400ms">
      {t("hero.subtitle")}
    </p>

    <!-- CTAs -->
    <div class="mt-10 flex flex-wrap justify-center gap-4 hero-in" style="--d:520ms">
      <a href={localizedPath(locale, "/booking")} class="btn-primary">{t("hero.cta")}</a>
      <a href="#hours" class="btn-ghost">{t("hero.secondaryCta")}</a>
    </div>
  </div>

  <!-- Scroll cue -->
  <a href="#about" class="absolute bottom-6 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-[var(--color-fg-subtle)] hover:text-[var(--color-gold)] transition-colors duration-300 hero-in" style="--d:700ms" aria-label="Scroll down">
    <span class="text-[0.58rem] uppercase tracking-[0.35em]">{t("hero.tonight")}</span>
    <span class="h-10 w-px scroll-line" style="background: linear-gradient(to bottom, var(--color-gold-deep), transparent);"></span>
  </a>
</section>

<style>
  @keyframes hero-in {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .hero-in {
    opacity: 0;
    animation: hero-in 1.0s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: var(--d, 0ms);
  }

  @keyframes breathe {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.88; }
  }
  .hero-breathe {
    background:
      radial-gradient(ellipse 40% 35% at 25% 45%, oklch(from var(--color-gold) l c h / 0.06), transparent),
      radial-gradient(ellipse 35% 40% at 75% 55%, oklch(from var(--color-accent) l c h / 0.05), transparent);
    animation: breathe 7s ease-in-out infinite;
  }

  @keyframes pulse-ring {
    0%, 100% { box-shadow: 0 0 0 0 oklch(from var(--color-gold) l c h / 0.55); }
    50%       { box-shadow: 0 0 0 5px oklch(from var(--color-gold) l c h / 0); }
  }
  .status-pulse { animation: pulse-ring 2.5s ease-in-out infinite; }

  @keyframes scroll-drop {
    0%, 100% { transform: translateY(0); opacity: 1; }
    60%       { transform: translateY(6px); opacity: 0.4; }
  }
  .scroll-line { animation: scroll-drop 2s ease-in-out infinite; }

  @media (prefers-reduced-motion: reduce) {
    .hero-in { opacity: 1; animation: none; }
    .hero-breathe, .status-pulse, .scroll-line { animation: none; }
  }
</style>

<script>
  // Respect reduced-motion: freeze the ambient loop on its first frame.
  const mq = window.matchMedia("(prefers-reduced-motion: reduce)");
  const pauseIfReduced = () => {
    document.querySelectorAll<HTMLVideoElement>("section video").forEach((v) => {
      if (mq.matches) v.pause();
    });
  };
  pauseIfReduced();
  mq.addEventListener("change", pauseIfReduced);
</script>
