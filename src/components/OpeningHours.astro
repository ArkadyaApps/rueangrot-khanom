---
import { useTranslations, type Locale } from "@/i18n/utils";
import { siteConfig } from "@/config/site";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const dayKeys = [
  "monday",
  "tuesday",
  "wednesday",
  "thursday",
  "friday",
  "saturday",
  "sunday",
] as const;

const tz = siteConfig.timezone;
const fmt = new Intl.DateTimeFormat("en-US", { weekday: "long", timeZone: tz });
const todayName = fmt.format(new Date()).toLowerCase() as (typeof dayKeys)[number];
const todaySlot = siteConfig.hours[todayName];
---

<section class="container-narrow py-12 md:py-20" id="hours">
  <div class="grid md:grid-cols-12 gap-8 md:gap-12">
    <!-- Today, in large display type -->
    <div class="md:col-span-5 md:sticky md:top-32 reveal">
      <p class="eyebrow mb-5">{t("hours.title")}</p>
      <p class="display italic text-[var(--color-gold-soft)] leading-[0.92]" style="font-size:clamp(2.6rem,6.5vw,5rem);">
        {todaySlot ? t("hours.openLabel") : t("hours.closedLabel")}
      </p>
      <p class="mt-4 text-2xl text-[var(--color-fg-muted)] font-light">
        {todaySlot ? `${todaySlot.open} – ${todaySlot.close}` : t("hours.closedSubline")}
      </p>
    </div>

    <!-- Full week, compact -->
    <div class="md:col-span-6 md:col-start-7 reveal reveal-d2">
      <ul>
        {
          dayKeys.map((day, i) => {
            const slot = siteConfig.hours[day];
            const isToday = day === todayName;
            return (
              <li
                class={`flex items-baseline justify-between py-3 ${i < dayKeys.length - 1 ? "border-b border-[var(--color-line)]" : ""}`}
              >
                <span
                  class="text-sm tracking-[0.2em] uppercase font-light"
                  style={isToday ? "color:var(--color-gold);font-weight:500;" : "color:var(--color-fg-muted);"}
                >
                  {t(`hours.${day}`)}
                </span>
                <span
                  class="font-display italic text-xl"
                  style={isToday
                    ? slot
                      ? "color:var(--color-gold-soft)"
                      : "color:var(--color-fg-muted)"
                    : "color:var(--color-fg-muted)"}
                >
                  {slot ? `${slot.open} – ${slot.close}` : t("hours.closed")}
                </span>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</section>
