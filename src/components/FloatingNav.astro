---
import { useTranslations, localizedPath, type Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const links = [
  { href: localizedPath(locale, "/"), label: t("nav.home") },
  { href: localizedPath(locale, "/menu"), label: t("nav.menu") },
  { href: localizedPath(locale, "/booking"), label: t("nav.booking") },
  { href: localizedPath(locale, "/contact"), label: t("nav.contact") },
];
---

<details class="nav-float fixed top-5 left-5 z-50">
  <summary
    class="list-none cursor-pointer h-12 w-12 rounded-full border border-[var(--color-line-strong)] bg-[oklch(from_var(--color-bg)_l_c_h_/_0.7)] backdrop-blur-md flex items-center justify-center hover:border-[var(--color-gold)] transition-colors [&::-webkit-details-marker]:hidden"
    aria-label="Menu"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" class="text-[var(--color-fg)]" aria-hidden="true">
      <path d="M3 6h18M3 12h18M3 18h18" />
    </svg>
  </summary>

  <nav class="absolute top-14 left-0 min-w-[190px] panel py-2 flex flex-col">
    {
      links.map((l) => (
        <a
          href={l.href}
          class="px-5 py-2.5 text-[0.72rem] uppercase tracking-[0.22em] text-[var(--color-fg-muted)] hover:text-[var(--color-gold)] transition-colors"
        >
          {l.label}
        </a>
      ))
    }
  </nav>
</details>
