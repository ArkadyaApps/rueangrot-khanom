---
import { useTranslations, localizedPath, type Locale } from "@/i18n/utils";
import { siteConfig } from "@/config/site";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();
const directionsHref = `https://www.google.com/maps/dir/?api=1&destination=${siteConfig.contact.mapsLat},${siteConfig.contact.mapsLng}`;
const whatsappHref = `https://wa.me/${siteConfig.contact.whatsapp.replace(/\D/g, "")}`;
---

<footer class="mt-16 pt-12 md:pt-16 border-t border-[var(--color-line)] overflow-hidden">
  <!-- Logo + billboard wordmark, on one line -->
  <div class="container-narrow reveal">
    <div
      class="flex flex-wrap items-center"
      style={`font-size:${siteConfig.images.logo ? "clamp(2.75rem,10vw,7.5rem)" : "clamp(2.5rem,11vw,9rem)"}; gap:0.16em;`}
    >
      {siteConfig.images.logo && (
        <img
          src={siteConfig.images.logo}
          alt=""
          aria-hidden="true"
          style="height:max(1.1em,4rem); width:max(1.1em,4rem); object-fit:contain; flex-shrink:0;"
        />
      )}
      <p
        class="display italic text-[var(--color-gold-soft)] leading-[0.85]"
        style="font-size:1em; letter-spacing:-0.02em;"
      >
        {siteConfig.name}
      </p>
    </div>
  </div>

  <!-- Info strip — asymmetric, not centered -->
  <div class="container-narrow mt-10 md:mt-12 pb-10">
    <div class="grid md:grid-cols-3 gap-10 md:gap-8 pt-10 border-t border-[var(--color-line)]">
      <div class="reveal">
        <p class="eyebrow mb-3">{t("contact.addressLabel")}</p>
        <p class="text-sm text-[var(--color-fg-muted)] leading-relaxed max-w-[22ch]">
          {t("footer.addressShort")}
        </p>
        <a
          href={directionsHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block mt-3 text-[0.7rem] uppercase tracking-[0.22em] text-[var(--color-gold-deep)] hover:text-[var(--color-gold)] transition-colors"
        >
          {t("contact.directions")} →
        </a>
      </div>

      <div class="reveal reveal-d1">
        <p class="eyebrow mb-3">{t("hours.title")}</p>
        <p class="text-sm text-[var(--color-fg-muted)] leading-relaxed max-w-[22ch]">
          {t("footer.hoursShort")}
        </p>
        <a
          href={localizedPath(locale, "/booking")}
          class="inline-block mt-3 text-[0.7rem] uppercase tracking-[0.22em] text-[var(--color-gold-deep)] hover:text-[var(--color-gold)] transition-colors"
        >
          {t("reservation.cta")} →
        </a>
      </div>

      <div class="reveal reveal-d2 md:text-right">
        <p class="eyebrow mb-3">{t("contact.whatsappLabel")}</p>
        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-[var(--color-gold)] hover:text-[var(--color-gold-soft)]"
        >
          {siteConfig.contact.whatsappDisplay}
        </a>
        {siteConfig.contact.socialType !== "none" && siteConfig.contact.socialUrl && (
          <a
            href={siteConfig.contact.socialUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="block mt-3 text-[0.7rem] uppercase tracking-[0.22em] text-[var(--color-gold-deep)] hover:text-[var(--color-gold)] transition-colors"
          >
            {t("social.follow")} →
          </a>
        )}
      </div>
    </div>

    <div class="flex flex-col md:flex-row items-center md:items-baseline justify-between gap-3 mt-10 pt-6 border-t border-[var(--color-line)]">
      <p class="text-[0.66rem] uppercase tracking-[0.32em] text-[var(--color-fg-subtle)]">
        {t("footer.tagline")}
      </p>
      <p class="text-xs text-[var(--color-fg-subtle)]">
        © {year} · {t("footer.rights")}
      </p>
    </div>
  </div>
</footer>
