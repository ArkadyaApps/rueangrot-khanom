---
import { useTranslations, type Locale } from "@/i18n/utils";
import { siteConfig } from "@/config/site";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const { mapsLat, mapsLng, whatsapp, socialUrl, socialType, whatsappDisplay, socialHandle } = siteConfig.contact;
const delta = 0.008;
const mapSrc = `https://www.openstreetmap.org/export/embed.html?bbox=${mapsLng - delta},${mapsLat - delta},${mapsLng + delta},${mapsLat + delta}&layer=mapnik&marker=${mapsLat},${mapsLng}`;
const directionsHref = `https://www.google.com/maps/dir/?api=1&destination=${mapsLat},${mapsLng}`;
const whatsappHref = `https://wa.me/${whatsapp.replace(/\D/g, "")}`;
---

<section class="grid md:grid-cols-12 items-stretch">
  <!-- Typographic info column — raw, no card, no centering -->
  <div class="md:col-span-5 flex flex-col justify-center px-6 md:pl-[max(2.5rem,calc((100vw-68rem)/2+1.25rem))] md:pr-14 py-12 md:py-20 reveal">
    <p class="eyebrow mb-6">{t("contact.title")}</p>
    <p class="display italic text-[clamp(2.2rem,5vw,3.4rem)] text-[var(--color-gold-soft)] leading-[1.05] mb-8">
      {t("contact.address")}
    </p>

    <div class="space-y-6 border-t border-[var(--color-line)] pt-8">
      <div class="flex items-baseline justify-between gap-4">
        <span class="eyebrow shrink-0">{t("contact.whatsappLabel")}</span>
        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="text-lg text-[var(--color-gold)] hover:text-[var(--color-gold-soft)] transition-colors text-right"
        >
          {whatsappDisplay}
        </a>
      </div>

      {socialType !== "none" && socialUrl && (
        <div class="flex items-baseline justify-between gap-4">
          <span class="eyebrow shrink-0 capitalize">{socialType}</span>
          <a
            href={socialUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-base text-[var(--color-fg-muted)] hover:text-[var(--color-gold)] transition-colors tracking-wide text-right"
          >
            {socialHandle ? `@${socialHandle}` : t("social.follow")}
          </a>
        </div>
      )}
    </div>

    <a
      href={directionsHref}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-ghost self-start mt-10"
    >
      {t("contact.directions")}
    </a>
  </div>

  <!-- Map — full-bleed, no card frame -->
  <div class="md:col-span-7 min-h-[380px] md:min-h-0 reveal reveal-d2">
    <iframe
      src={mapSrc}
      title="Map"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      class="w-full h-full min-h-[380px] grayscale-[0.7] contrast-[1.1] opacity-90"
      style="border:0; display:block;"></iframe>
  </div>
</section>
